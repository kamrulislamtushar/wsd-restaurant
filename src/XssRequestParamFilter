package com.legacy.filter;

import org.jsoup.safety.Safelist;

/**
 * XSS Safelist Configuration
 *
 * Uses Safelist.none() which strips ALL HTML tags from user input.
 * This is the most secure option when your application never needs HTML as input.
 */
public class CustomSafelist {

    private static Safelist instance;

    /**
     * Get the safelist instance
     * @return Safelist that strips ALL HTML
     */
    public static Safelist get() {
        if (instance == null) {
            instance = Safelist.none();
        }
        return instance;
    }
}


