package com.legacy.filter;

import org.jsoup.Jsoup;
import org.jsoup.safety.Safelist;

/**
 * XSS Sanitization Utility
 *
 * Provides methods to clean user input by stripping ALL HTML tags.
 */
public class XSSSanitizer {

    /**
     * Clean user input by stripping ALL HTML tags
     *
     * @param input Raw user input (may contain HTML/scripts)
     * @return Sanitized text with all HTML stripped
     *
     * Examples:
     * - Input:  "<script>alert('XSS')</script>Hello"
     *   Output: "Hello"
     *
     * - Input:  "<b>Bold</b> text"
     *   Output: "Bold text"
     *
     * - Input:  "Plain text"
     *   Output: "Plain text"
     */
    public static String cleanUserInput(String input) {
        if (input == null || input.trim().isEmpty()) {
            return input;
        }

        // Safelist.none() strips ALL HTML tags, keeping only text content
        return Jsoup.clean(input, Safelist.none());
    }
}


