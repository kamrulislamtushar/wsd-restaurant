package com.legacy.filter;

import org.springframework.core.MethodParameter;
import org.springframework.http.HttpInputMessage;
import org.springframework.http.converter.HttpMessageConverter;
import org.springframework.web.bind.annotation.ControllerAdvice;
import org.springframework.web.servlet.mvc.method.annotation.RequestBodyAdviceAdapter;

import java.lang.reflect.Field;
import java.lang.reflect.Type;
import java.util.List;
import java.util.Map;

/**
 * Request Body Advice to sanitize JSON/XML request bodies
 *
 * Intercepts @RequestBody annotated parameters and sanitizes all string fields.
 * This is Layer 2 of XSS protection.
 *
 * Example:
 * @PostMapping("/user/create")
 * public String create(@RequestBody UserDTO user) {
 *     // user.name, user.email, etc. are already sanitized
 * }
 */
@ControllerAdvice
public class XssRequestBodyAdvice extends RequestBodyAdviceAdapter {

    @Override
    public boolean supports(MethodParameter methodParameter, Type targetType,
                            Class<? extends HttpMessageConverter<?>> converterType) {
        // Apply to ALL request bodies
        return true;
    }

    @Override
    public Object afterBodyRead(Object body, HttpInputMessage inputMessage,
                                MethodParameter parameter, Type targetType,
                                Class<? extends HttpMessageConverter<?>> converterType) {
        // Sanitize the request body before it reaches the controller
        return sanitizeObject(body);
    }

    /**
     * Recursively sanitize an object
     */
    private Object sanitizeObject(Object body) {
        if (body == null) {
            return null;
        }

        if (body instanceof Map) {
            // Sanitize Map values
            Map<Object, Object> map = (Map<Object, Object>) body;
            map.replaceAll((k, v) -> v instanceof String ?
                    XSSSanitizer.cleanUserInput((String) v) : v);
        } else if (body instanceof List) {
            // Sanitize List elements
            ((List<?>) body).forEach(this::sanitizeObject);
        } else {
            // Sanitize POJO fields
            sanitizeFields(body);
        }

        return body;
    }

    /**
     * Sanitize all String fields in an object using reflection
     */
    private void sanitizeFields(Object obj) {
        if (obj == null) {
            return;
        }

        Field[] fields = obj.getClass().getDeclaredFields();
        for (Field field : fields) {
            if (field.getType().equals(String.class)) {
                field.setAccessible(true);
                try {
                    String value = (String) field.get(obj);
                    if (value != null) {
                        field.set(obj, XSSSanitizer.cleanUserInput(value));
                    }
                } catch (IllegalAccessException e) {
                    // Skip fields we can't access
                }
            }
        }
    }
}


