package com.legacy.filter;

import org.springframework.stereotype.Component;
import org.springframework.ui.ModelMap;
import org.springframework.web.servlet.HandlerInterceptor;
import org.springframework.web.servlet.ModelAndView;

import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;
import java.lang.reflect.Field;
import java.util.List;
import java.util.Map;

/**
 * STRICT MODE: Strips ALL HTML from model attributes before JSP rendering
 */
@Component
public class XssModelSanitizerInterceptor implements HandlerInterceptor {

    @Override
    public void postHandle(HttpServletRequest request,
                          HttpServletResponse response,
                          Object handler,
                          ModelAndView modelAndView) {

        if (modelAndView == null || modelAndView.getModel() == null) {
            return;
        }

        // Don't sanitize the main page load
        String viewName = modelAndView.getViewName();
        if (viewName != null && (viewName.equals("main") || viewName.equals("home"))) {
            return;
        }

        // STRICT: Strip ALL HTML from model attributes
        ModelMap model = modelAndView.getModelMap();
        model.forEach((key, value) -> {
            Object sanitized = sanitizeObject(value);
            model.put(key, sanitized);
        });
    }

    private Object sanitizeObject(Object obj) {
        if (obj == null) return null;

        if (obj instanceof String) {
            // STRICT: Strip ALL HTML
            return XSSSanitizer.cleanUserInput((String) obj);
        } else if (obj instanceof Map) {
            Map<Object, Object> map = (Map<Object, Object>) obj;
            map.replaceAll((k, v) -> sanitizeObject(v));
            return map;
        } else if (obj instanceof List) {
            List<?> list = (List<?>) obj;
            for (int i = 0; i < list.size(); i++) {
                ((List<Object>) list).set(i, sanitizeObject(list.get(i)));
            }
            return list;
        } else {
            sanitizeFields(obj);
            return obj;
        }
    }

    private void sanitizeFields(Object obj) {
        if (obj == null) return;

        Class<?> clazz = obj.getClass();
        if (clazz.getName().startsWith("java.") || clazz.isPrimitive()) {
            return;
        }

        Field[] fields = clazz.getDeclaredFields();
        for (Field field : fields) {
            field.setAccessible(true);

            try {
                Object value = field.get(obj);
                if (value == null) continue;

                if (field.getType().equals(String.class)) {
                    // STRICT: Strip ALL HTML
                    String sanitized = XSSSanitizer.cleanUserInput((String) value);
                    field.set(obj, sanitized);
                } else if (!field.getType().isPrimitive() &&
                           !field.getType().getName().startsWith("java.")) {
                    sanitizeFields(value);
                }
            } catch (IllegalAccessException ignored) {}
        }
    }
}

