package com.legacy.filter;

import org.springframework.stereotype.Component;
import org.springframework.ui.ModelMap;
import org.springframework.web.servlet.HandlerInterceptor;
import org.springframework.web.servlet.ModelAndView;

import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;
import java.lang.reflect.Field;
import java.util.List;
import java.util.Map;

/**
 * Handler Interceptor to sanitize Model attributes before JSP rendering
 *
 * This is Layer 3 (final layer) of XSS protection.
 * Sanitizes all data added to Model before it reaches the JSP view.
 *
 * This ensures that ${...} expressions in JSPs display safe content.
 *
 * Example:
 * @GetMapping("/profile")
 * public String showProfile(Model model) {
 *     model.addAttribute("userName", userInput);  // Sanitized by this interceptor
 *     return "profile";  // profile.jsp
 * }
 *
 * In JSP:
 * <div>${userName}</div>  <!-- Safe, already sanitized -->
 */
@Component
public class XssModelSanitizerInterceptor implements HandlerInterceptor {

    /**
     * Called after controller method executes but before JSP renders
     */
    @Override
    public void postHandle(HttpServletRequest request,
                          HttpServletResponse response,
                          Object handler,
                          ModelAndView modelAndView) {

        if (modelAndView == null || modelAndView.getModel() == null) {
            return;
        }

        // Sanitize all model attributes
        ModelMap model = modelAndView.getModelMap();
        model.forEach((key, value) -> {
            Object sanitized = sanitizeObject(value);
            model.put(key, sanitized);
        });
    }

    /**
     * Recursively sanitize an object
     */
    private Object sanitizeObject(Object obj) {
        if (obj == null) {
            return null;
        }

        if (obj instanceof String) {
            // Sanitize string values
            return XSSSanitizer.cleanUserInput((String) obj);
        } else if (obj instanceof Map) {
            // Sanitize Map values
            Map<Object, Object> map = (Map<Object, Object>) obj;
            map.replaceAll((k, v) -> sanitizeObject(v));
            return map;
        } else if (obj instanceof List) {
            // Sanitize List elements
            List<?> list = (List<?>) obj;
            for (int i = 0; i < list.size(); i++) {
                ((List<Object>) list).set(i, sanitizeObject(list.get(i)));
            }
            return list;
        } else {
            // Sanitize POJO fields
            sanitizeFields(obj);
            return obj;
        }
    }

    /**
     * Sanitize all String fields in an object using reflection
     */
    private void sanitizeFields(Object obj) {
        if (obj == null) {
            return;
        }

        Class<?> clazz = obj.getClass();

        // Skip Java built-in classes
        if (clazz.getName().startsWith("java.") ||
            clazz.getName().startsWith("javax.") ||
            clazz.isPrimitive()) {
            return;
        }

        Field[] fields = clazz.getDeclaredFields();
        for (Field field : fields) {
            field.setAccessible(true);

            try {
                Object value = field.get(obj);
                if (value == null) {
                    continue;
                }

                if (field.getType().equals(String.class)) {
                    // Sanitize string fields
                    String sanitized = XSSSanitizer.cleanUserInput((String) value);
                    field.set(obj, sanitized);
                } else if (!field.getType().isPrimitive() &&
                           !field.getType().getName().startsWith("java.")) {
                    // Recursively sanitize nested objects
                    sanitizeFields(value);
                }
            } catch (IllegalAccessException e) {
                // Skip fields we can't access
            }
        }
    }
}


